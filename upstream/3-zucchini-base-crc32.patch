From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Melanie Riise <me@mriise.net>
Date: Fri, 23 Oct 2026 05:37:00 -0700
Subject: [PATCH] zucchini: Compute CRC-32 with base::Crc32

CalculateCrc32() uses a byte-at-a-time table loop. base::Crc32 wraps
zlib's crc32_z, which dispatches to SSE4.2/PCLMUL on x86 and CRC32/PMULL
on Arm with a portable fallback. //components/zucchini already depends
on //base, and //base already depends on zlib, so this adds no new
dependency.

base::Crc32 takes and returns the uncomplemented state, so
~base::Crc32(0xFFFFFFFF, data) is exactly CRC-32/ISO-HDLC, including 0
for empty input. Patch headers and their CRC values are unchanged.

Measured on an AMD Ryzen 9 7950X (Windows x64, clang-cl 21, /O2),
Zucchini sources built outside GN, medians of 9 rounds:

  CRC of 177 MiB:          295 ms -> 11.2 ms
  CRC of 1 MiB:           1.69 ms -> 0.056 ms
  Apply 16 MiB raw patch: 57.6 ms -> 5.56 ms

Tests: new Crc32Test cases check the empty span, the standard check
value, and every length 0..511 plus block boundaries up to 65537 at 16
offsets against a bitwise reference. Inputs end at the allocation
boundary so ASan catches overreads.

Bug: TODO_FILE_CRBUG
---
 components/zucchini/crc32.cc          | 31 +++----------------
 components/zucchini/crc32_unittest.cc | 44 +++++++++++++++++++++++++++
 2 files changed, 48 insertions(+), 27 deletions(-)

diff --git a/components/zucchini/crc32.cc b/components/zucchini/crc32.cc
index 254ae802..3aae20bd 100644
--- a/components/zucchini/crc32.cc
+++ b/components/zucchini/crc32.cc
@@ -4,37 +4,14 @@
 
 #include "components/zucchini/crc32.h"
 
-#include <array>
+#include "base/metrics/crc32.h"
 
 namespace zucchini {
 
-namespace {
-
-std::array<uint32_t, 256> MakeCrc32Table() {
-  constexpr uint32_t kCrc32Poly = 0xEDB88320;
-
-  std::array<uint32_t, 256> crc32Table;
-  for (uint32_t i = 0; i < 256; ++i) {
-    uint32_t r = i;
-    for (int j = 0; j < 8; ++j)
-      r = (r >> 1) ^ (kCrc32Poly & ~((r & 1) - 1));
-    crc32Table[i] = r;
-  }
-  return crc32Table;
-}
-
-}  // namespace
-
-// Minimalistic CRC-32 implementation for Zucchini usage. Adapted from LZMA SDK
-// (found at third_party/lzma_sdk/src/C/7zCrc.c), which is public domain.
 uint32_t CalculateCrc32(base::span<const uint8_t> data) {
-  static const std::array<uint32_t, 256> kCrc32Table = MakeCrc32Table();
-
-  uint32_t ret = 0xFFFFFFFF;
-  for (uint8_t byte : data) {
-    ret = kCrc32Table[(ret ^ byte) & 0xFF] ^ (ret >> 8);
-  }
-  return ret ^ 0xFFFFFFFF;
+  // base::Crc32 returns the uncomplemented state; Zucchini uses
+  // CRC-32/ISO-HDLC.
+  return ~base::Crc32(0xFFFFFFFFU, data);
 }
 
 }  // namespace zucchini
diff --git a/components/zucchini/crc32_unittest.cc b/components/zucchini/crc32_unittest.cc
index b0c8b649..c87801bc 100644
--- a/components/zucchini/crc32_unittest.cc
+++ b/components/zucchini/crc32_unittest.cc
@@ -4,9 +4,11 @@
 
 #include "components/zucchini/crc32.h"
 
+#include <stddef.h>
 #include <stdint.h>
 
 #include <array>
+#include <vector>
 
 #include "base/containers/span.h"
 #include "testing/gtest/include/gtest/gtest.h"
@@ -39,4 +41,46 @@ TEST(Crc32Test, All) {
   EXPECT_EQ(0x0762F38BU, CalculateCrc32(data.first(9u)));
 }
 
+TEST(Crc32Test, EmptySpan) {
+  EXPECT_EQ(0U, CalculateCrc32({}));
+}
+
+TEST(Crc32Test, IsoHdlcCheckValue) {
+  constexpr uint8_t kCheck[] = {'1', '2', '3', '4', '5', '6', '7', '8', '9'};
+  EXPECT_EQ(0xCBF43926U, CalculateCrc32(kCheck));
+}
+
+TEST(Crc32Test, BlockBoundariesAndAlignment) {
+  std::vector<size_t> lengths = {512,  513,   4095,  4096,
+                                 4097, 65535, 65536, 65537};
+  for (size_t length = 0; length < 512; ++length) {
+    lengths.push_back(length);
+  }
+  uint32_t random = 1;
+  for (size_t length : lengths) {
+    for (size_t offset = 0; offset < 16; ++offset) {
+      // End the input at the allocation boundary so ASan detects overreads.
+      std::vector<uint8_t> data(length + offset + 1);
+      for (uint8_t& byte : data) {
+        random ^= random << 13;
+        random ^= random >> 17;
+        random ^= random << 5;
+        byte = static_cast<uint8_t>(random);
+      }
+      const auto input = base::span(data).subspan(offset + 1);
+      // Independent bit-at-a-time reference, with the same initial and final
+      // complements as CRC-32/ISO-HDLC. Every SIMD tail length is covered.
+      uint32_t expected = 0xFFFFFFFF;
+      for (size_t i = 0; i < length; ++i) {
+        expected ^= input[i];
+        for (int bit = 0; bit < 8; ++bit) {
+          expected = (expected >> 1) ^ (0xEDB88320U & (0U - (expected & 1)));
+        }
+      }
+      EXPECT_EQ(expected ^ 0xFFFFFFFF, CalculateCrc32(input))
+          << "offset=" << offset << " length=" << length;
+    }
+  }
+}
+
 }  // namespace zucchini
