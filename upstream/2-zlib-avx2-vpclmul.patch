     /* XGETBV needs XSAVE and OSXSAVE. */
     if (x86_cpu_enable_simd && (abcd[2] & 0x0c000000) == 0x0c000000) {
 #ifdef _MSC_VER
@@ -206,8 +208,14 @@ static void _cpu_check_features(void)
 #else
             __cpuid_count(7, 0, abcd[0], abcd[1], abcd[2], abcd[3]);
 #endif
+#ifdef CRC32_SIMD_AVX512_PCLMUL
             x86_cpu_enable_avx512 = x86_cpu_has_avx512_pclmul(
