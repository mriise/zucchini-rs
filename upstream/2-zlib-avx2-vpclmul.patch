 static void _cpu_check_features(void)
@@ -192,7 +194,7 @@ static void _cpu_check_features(void)
                           x86_cpu_has_sse42 &&
                           x86_cpu_has_pclmulqdq;
 
-#ifdef CRC32_SIMD_AVX512_PCLMUL
