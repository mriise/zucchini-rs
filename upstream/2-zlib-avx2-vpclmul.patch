diff --git a/third_party/zlib/cpu_features.c b/third_party/zlib/cpu_features.c
index d04551c5..32025dc5 100644
--- a/third_party/zlib/cpu_features.c
+++ b/third_party/zlib/cpu_features.c
@@ -32,6 +32,7 @@ int ZLIB_INTERNAL x86_cpu_enable_sse2 = 0;
 int ZLIB_INTERNAL x86_cpu_enable_ssse3 = 0;
 int ZLIB_INTERNAL x86_cpu_enable_simd = 0;
 int ZLIB_INTERNAL x86_cpu_enable_avx512 = 0;
+int ZLIB_INTERNAL x86_cpu_enable_avx2 = 0;
 
 int ZLIB_INTERNAL riscv_cpu_enable_rvv = 0;
 int ZLIB_INTERNAL riscv_cpu_enable_vclmul = 0;
@@ -156,13 +157,14 @@ static void _cpu_check_features(void)
 /* On x86 we simply use a instruction to check the CPU features.
  * (i.e. CPUID).
  */
-#ifdef CRC32_SIMD_AVX512_PCLMUL
+#if defined(CRC32_SIMD_AVX512_PCLMUL) || defined(CRC32_SIMD_AVX2_PCLMUL)
