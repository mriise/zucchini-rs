                           x86_cpu_has_pclmulqdq;
 
 #ifdef CRC32_SIMD_AVX512_PCLMUL
-    x86_cpu_enable_avx512 = _xgetbv(0) & 0x00000040;
+    /* XGETBV is only legal when both XSAVE and OSXSAVE are available. */
+    if (!x86_cpu_enable_simd || !x86_cpu_has_xsave_avx(leaf1_ecx))
