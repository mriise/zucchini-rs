+    __cpuidex(abcd, 7, 0);
+#else
+    __cpuid_count(7, 0, abcd[0], abcd[1], abcd[2], abcd[3]);
+#endif
+    x86_cpu_enable_avx512 = x86_cpu_has_avx512_pclmul(
+        leaf1_ecx, leaf1_edx, (uint32_t)abcd[1], (uint32_t)abcd[2], _xgetbv(0));
 #endif
 }
