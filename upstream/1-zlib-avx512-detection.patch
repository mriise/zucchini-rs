+TEST(ZlibTest, Avx512CrcRequiresCpuAndOsSupport) {
+  constexpr uint32_t kLeaf1Ecx = (1u << 1) | (1u << 19) | (1u << 20) |
+                                 (1u << 26) | (1u << 27) | (1u << 28);
+  constexpr uint32_t kLeaf1Edx = 1u << 26;
+  constexpr uint32_t kLeaf7Ebx = 1u << 16;
+  constexpr uint32_t kLeaf7Ecx = 1u << 10;
+  constexpr uint64_t kXcr0 = 0xe6;
+  EXPECT_TRUE(x86_cpu_has_avx512_pclmul(kLeaf1Ecx, kLeaf1Edx, kLeaf7Ebx,
+                                        kLeaf7Ecx, kXcr0));
+  // Every required CPU feature and OS-managed register bank is necessary.
+  for (unsigned bit : {1u, 19u, 20u, 26u, 27u, 28u}) {
+    EXPECT_FALSE(x86_cpu_has_avx512_pclmul(kLeaf1Ecx & ~(1u << bit), kLeaf1Edx,
+                                           kLeaf7Ebx, kLeaf7Ecx, kXcr0));
+  }
+  EXPECT_FALSE(
+      x86_cpu_has_avx512_pclmul(kLeaf1Ecx, 0, kLeaf7Ebx, kLeaf7Ecx, kXcr0));
+  EXPECT_FALSE(
+      x86_cpu_has_avx512_pclmul(kLeaf1Ecx, kLeaf1Edx, 0, kLeaf7Ecx, kXcr0));
+  // An AVX-512 CPU without VPCLMULQDQ must stay on the SSE fallback.
+  EXPECT_FALSE(
+      x86_cpu_has_avx512_pclmul(kLeaf1Ecx, kLeaf1Edx, kLeaf7Ebx, 0, kXcr0));
+  for (unsigned bit : {1u, 2u, 5u, 6u, 7u}) {
+    EXPECT_FALSE(x86_cpu_has_avx512_pclmul(kLeaf1Ecx, kLeaf1Edx, kLeaf7Ebx,
+                                           kLeaf7Ecx, kXcr0 & ~(1ull << bit)));
+  }
+  EXPECT_TRUE(x86_cpu_has_avx512_pclmul(~0u, ~0u, ~0u, ~0u, ~0ull));
+  EXPECT_FALSE(x86_cpu_has_xsave_avx(0));
+}
+
+TEST(ZlibTest, Crc32VectorBoundariesAndSeeds) {
+  // Initialize CPU dispatch before exercising the public API.
+  (void)crc32_z(0, Z_NULL, 0);
+  std::vector<unsigned char> bytes(4096 + 64);
+  uint32_t random = 1;
+  for (auto& byte : bytes) {
+    random ^= random << 13;
+    random ^= random >> 17;
+    random ^= random << 5;
+    byte = static_cast<unsigned char>(random);
+  }
+  for (size_t offset = 0; offset < 64; ++offset) {
+    for (size_t length :
+         {255u, 256u, 257u, 319u, 320u, 321u, 511u, 512u, 513u, 4095u, 4096u}) {
+      for (uint32_t seed : {0u, 1u, 0x12345678u, 0xffffffffu}) {
+        uint32_t expected = ~seed;
+        for (size_t i = 0; i < length; ++i) {
+          expected ^= bytes[offset + i];
+          for (unsigned bit = 0; bit < 8; ++bit)
+            expected = (expected >> 1) ^ (0xedb88320u & (0u - (expected & 1)));
+        }
+        const auto* first = bytes.data() + offset;
+        EXPECT_EQ(~expected, crc32_z(seed, first, length));
+        const size_t split = length / 2;
+        EXPECT_EQ(~expected, crc32_z(crc32_z(seed, first, split), first + split,
+                                     length - split));
+      }
+    }
+  }
+}
+
 void TestPayloads(size_t input_size, zlib_internal::WrapperType type,
                   const int compression_level = Z_DEFAULT_COMPRESSION) {
   std::vector<unsigned char> input;
