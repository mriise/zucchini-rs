--- a/components/zucchini/crc32_unittest.cc
+++ b/components/zucchini/crc32_unittest.cc
@@ -4,9 +4,11 @@
 
 #include "components/zucchini/crc32.h"
 
+#include <stddef.h>
 #include <stdint.h>
 
 #include <array>
+#include <vector>
 
 #include "base/containers/span.h"
 #include "testing/gtest/include/gtest/gtest.h"
@@ -39,4 +41,46 @@ TEST(Crc32Test, All) {
   EXPECT_EQ(0x0762F38BU, CalculateCrc32(data.first(9u)));
 }
 
+TEST(Crc32Test, EmptySpan) {
+  EXPECT_EQ(0U, CalculateCrc32({}));
+}
+
+TEST(Crc32Test, IsoHdlcCheckValue) {
+  constexpr uint8_t check[] = {'1', '2', '3', '4', '5', '6', '7', '8', '9'};
+  EXPECT_EQ(0xCBF43926U, CalculateCrc32(check));
+}
+
+TEST(Crc32Test, BlockBoundariesAndAlignment) {
+  std::vector<size_t> lengths = {512,  513,   4095,  4096,
+                                 4097, 65535, 65536, 65537};
+  for (size_t length = 0; length < 512; ++length) {
+    lengths.push_back(length);
+  }
+  uint32_t random = 1;
+  for (size_t length : lengths) {
+    for (size_t offset = 0; offset < 16; ++offset) {
+      // End the input at the allocation boundary so ASan detects overreads.
+      std::vector<uint8_t> data(length + offset + 1);
+      for (uint8_t& byte : data) {
+        random ^= random << 13;
+        random ^= random >> 17;
+        random ^= random << 5;
+        byte = static_cast<uint8_t>(random);
+      }
+      const auto input = base::span(data).subspan(offset + 1);
+      // Independent bit-at-a-time reference, with the same initial and final
+      // complements as CRC-32/ISO-HDLC. Every SIMD tail length is covered.
+      uint32_t expected = 0xFFFFFFFF;
+      for (size_t i = 0; i < length; ++i) {
+        expected ^= input[i];
+        for (int bit = 0; bit < 8; ++bit) {
+          expected = (expected >> 1) ^ (0xEDB88320U & (0U - (expected & 1)));
+        }
+      }
+      EXPECT_EQ(expected ^ 0xFFFFFFFF, CalculateCrc32(input))
+          << "offset=" << offset << " length=" << length;
+    }
+  }
+}
+
 }  // namespace zucchini
