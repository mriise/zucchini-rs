Guard AVX-512/VPCLMUL with full CPU and OS state checks and zero the initial CRC lanes.
The source build enables the kernel with a per-function target attribute, not global AVX flags.
See upstream/zlib-avx512.patch for the Chromium GN integration and unit tests.

--- a/third_party/zlib/cpu_features.c
+++ b/third_party/zlib/cpu_features.c
@@ -172,6 +172,10 @@
     int x86_cpu_has_sse42;
     int x86_cpu_has_pclmulqdq;
     int abcd[4];
+#ifdef CRC32_SIMD_AVX512_PCLMUL
+    uint32_t leaf1_ecx;
+    uint32_t leaf1_edx;
+#endif
 
 #ifdef _MSC_VER
     __cpuid(abcd, 1);
@@ -183,6 +187,10 @@
     x86_cpu_has_ssse3 = abcd[2] & 0x000200;
     x86_cpu_has_sse42 = abcd[2] & 0x100000;
     x86_cpu_has_pclmulqdq = abcd[2] & 0x2;
+#ifdef CRC32_SIMD_AVX512_PCLMUL
+    leaf1_ecx = (uint32_t)abcd[2];
+    leaf1_edx = (uint32_t)abcd[3];
+#endif
 
     x86_cpu_enable_sse2 = x86_cpu_has_sse2;
 
@@ -193,7 +201,23 @@
                           x86_cpu_has_pclmulqdq;
 
 #ifdef CRC32_SIMD_AVX512_PCLMUL
-    x86_cpu_enable_avx512 = _xgetbv(0) & 0x00000040;
+    /* XGETBV is only legal when both XSAVE and OSXSAVE are available. */
+    if (!x86_cpu_enable_simd || !x86_cpu_has_xsave_avx(leaf1_ecx))
+        return;
+#ifdef _MSC_VER
+    __cpuid(abcd, 0);
+#else
+    __cpuid(0, abcd[0], abcd[1], abcd[2], abcd[3]);
+#endif
+    if ((unsigned)abcd[0] < 7)
+        return;
+#ifdef _MSC_VER
+    __cpuidex(abcd, 7, 0);
+#else
+    __cpuid_count(7, 0, abcd[0], abcd[1], abcd[2], abcd[3]);
+#endif
+    x86_cpu_enable_avx512 = x86_cpu_has_avx512_pclmul(
+        leaf1_ecx, leaf1_edx, (uint32_t)abcd[1], (uint32_t)abcd[2], _xgetbv(0));
