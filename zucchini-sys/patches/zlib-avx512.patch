+#ifndef THIRD_PARTY_ZLIB_CPU_FEATURES_H_
+#define THIRD_PARTY_ZLIB_CPU_FEATURES_H_
+
+#include <stdint.h>
+
 #include "zlib.h"
+
+/* Check OSXSAVE before executing XGETBV, including on CPUs without AVX. */
+static inline int x86_cpu_has_xsave_avx(uint32_t leaf1_ecx) {
+    const uint32_t required = (1u << 26) | (1u << 27) | (1u << 28);
+    return (leaf1_ecx & required) == required;
+}
+
+/* Keep instruction support separate from OS register-state support. In
+ * particular, AVX-512F does not imply VPCLMULQDQ (e.g. Skylake-X).
+ * The kernel also uses legacy PCLMUL and SSE4.1 for its final reduction. */
+static inline int x86_cpu_has_avx512_pclmul(uint32_t leaf1_ecx,
+                                            uint32_t leaf1_edx,
+                                            uint32_t leaf7_ebx,
+                                            uint32_t leaf7_ecx,
+                                            uint64_t xcr0) {
+    const uint32_t required_ecx = (1u << 1) | (1u << 19) | (1u << 20);
+    /* XMM, YMM, opmask, ZMM_Hi256, and Hi16_ZMM state must all be enabled. */
+    const uint64_t required_xcr0 = 0xe6;
+    return x86_cpu_has_xsave_avx(leaf1_ecx) &&
+           (leaf1_ecx & required_ecx) == required_ecx &&
+           (leaf1_edx & (1u << 26)) != 0 && (leaf7_ebx & (1u << 16)) != 0 &&
+           (leaf7_ecx & (1u << 10)) != 0 &&
+           (xcr0 & required_xcr0) == required_xcr0;
+}
 
 /* TODO(cavalcantii): remove checks for x86_flags on deflate.
  */
@@ -20,3 +49,5 @@
 extern int riscv_cpu_enable_vclmul;
 
 void cpu_check_features(void);
+
+#endif /* THIRD_PARTY_ZLIB_CPU_FEATURES_H_ */
