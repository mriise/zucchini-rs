+// Reports progress through a loop over [0, |total|) at most about 256 times,
+// from |start| on.
+class ProgressLoop {
+ public:
+  explicit ProgressLoop(uint64_t total, uint64_t start = 0)
+      : total_(total), step_(total / 256 + 1), next_(start) {}
+
+  void At(uint64_t done) {
+    if (done >= next_) {
+      next_ = done + step_;
+      ReportProgress(total_ ? static_cast<double>(done) / total_ : 1.0);
+    }
+  }
+
+ private:
+  uint64_t total_;
+  uint64_t step_;
+  uint64_t next_;
+};
