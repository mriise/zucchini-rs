+// Progress reports and cancellation for generating and applying, defined by
+// zucchini-rs's C API (shim/zucchini_c.cc). Declared here because generating,
+// applying and suffix sorting all reach this header.
+namespace zucchini_rs {
+
+// Thrown out of Zucchini when the C API's progress callback cancels; the C API
+// returns ZUCC_CANCELLED. Not a std::exception, so nothing mistakes it for a
+// failure.
+struct Cancelled {};
+
+// Divides the enclosing range of progress reports into consecutive steps, and
+// restores it when destroyed. The outermost range is the whole C API call.
+// Does nothing when the call has no progress callback.
+class ProgressSteps {
+ public:
+  ProgressSteps();
+  ProgressSteps(const ProgressSteps&) = delete;
+  ProgressSteps& operator=(const ProgressSteps&) = delete;
+  ~ProgressSteps();
+
+  // Starts the next step, which runs from where the last one ended (or 0) to
+  // |end|, both fractions of the enclosing range. Reports the step's start, so
+  // it can throw Cancelled.
+  void Next(double end);
+
+ private:
+  bool active_ = false;
+  double lo_ = 0;
+  double hi_ = 0;
+  double begin_ = 0;
+};
+
+// Reports that |fraction| (0 to 1) of the current step is done, and throws
+// Cancelled if the callback asks to stop. Does nothing when the call has no
+// progress callback.
+void ReportProgress(double fraction);
+
+// Reports progress through a loop over [0, |total|) at most about 256 times.
+class ProgressLoop {
+ public:
+  explicit ProgressLoop(uint64_t total)
+      : total_(total), step_(total / 256 + 1) {}
+
+  void At(uint64_t done) {
+    if (done >= next_) {
+      next_ = done + step_;
+      ReportProgress(total_ ? static_cast<double>(done) / total_ : 1.0);
+    }
+  }
+
+ private:
+  uint64_t total_;
+  uint64_t step_;
+  uint64_t next_ = 0;
+};
+
