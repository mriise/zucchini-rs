+#include <stdint.h>
+
 #include "zlib.h"
 
+/* CPUID.1 features the VPCLMULQDQ CRC kernels use besides their own: SSE2,
+ * PCLMULQDQ, SSE4.1 (_mm_extract_epi32) and AVX with XSAVE and OSXSAVE. They
+ * are checked here instead of through x86_cpu_enable_simd, so that gating the
+ * SSE kernels differently cannot silently change what these need. */
+static inline int x86_cpu_has_crc_base(uint32_t leaf1_ecx,
+                                       uint32_t leaf1_edx) {
+    const uint32_t required_ecx = (1u << 1) | (1u << 19) | (1u << 26) |
+                                  (1u << 27) | (1u << 28);
+    return (leaf1_ecx & required_ecx) == required_ecx &&
+           (leaf1_edx & (1u << 26)) != 0;
+}
+
+/* AVX-512F does not imply VPCLMULQDQ (e.g. Skylake-X). XCR0 0xe6 is the XMM,
+ * YMM, opmask and ZMM state. */
+static inline int x86_cpu_has_avx512_pclmul(uint32_t leaf1_ecx,
+                                            uint32_t leaf1_edx,
+                                            uint32_t leaf7_ebx,
+                                            uint32_t leaf7_ecx,
+                                            uint64_t xcr0) {
+    return x86_cpu_has_crc_base(leaf1_ecx, leaf1_edx) &&
+           (leaf7_ebx & (1u << 16)) && (leaf7_ecx & (1u << 10)) &&
+           (xcr0 & 0xe6) == 0xe6;
+}
+
+/* Zen 3 and Intel client parts without AVX-512 have AVX2 VPCLMULQDQ. */
+static inline int x86_cpu_has_avx2_pclmul(uint32_t leaf1_ecx,
+                                          uint32_t leaf1_edx,
+                                          uint32_t leaf7_ebx,
+                                          uint32_t leaf7_ecx,
+                                          uint64_t xcr0) {
+    return x86_cpu_has_crc_base(leaf1_ecx, leaf1_edx) &&
+           (leaf7_ebx & (1u << 5)) && (leaf7_ecx & (1u << 10)) &&
+           (xcr0 & 0x6) == 0x6;
+}
+
